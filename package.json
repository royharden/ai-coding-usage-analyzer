{
  "name": "ai-coding-usage-analyzer",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only usage and cost accounting for Claude Code and Codex transcripts, checked against hand-computed fixtures.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "analyze": "tsx src/cli/main.ts",
    "eval": "tsx scripts/eval.ts",
    "demo": "tsx scripts/demo.ts",
    "crosscheck": "tsx scripts/crosscheck.ts",
    "check-fixtures": "tsx scripts/check-fixtures.ts",
    "freeze-fixtures": "tsx scripts/freeze-fixtures.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
