        },
        "bad_timestamp": {
          "$ref": "#/$defs/count"
        },
        "field_too_long": {
          "$ref": "#/$defs/count"
        },
        "blank_line": {
          "$ref": "#/$defs/count"
        },
        "synthetic_or_error_row": {
          "$ref": "#/$defs/count"
        },
        "files_empty": {
          "$ref": "#/$defs/count"
        },
        "compressed_unsupported": {
          "$ref": "#/$defs/count"
        },
        "file_read_error": {
          "$ref": "#/$defs/count"
        },
        "codex_session_unidentified": {
          "$ref": "#/$defs/count"
        },
        "ignored_non_jsonl": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "counters": {
      "type": "object",
      "properties": {
        "ignored_record_kind": {
          "$ref": "#/$defs/count"
        },
        "codex_token_count_empty": {
