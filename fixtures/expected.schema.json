        },
        "assumed5m": {
          "$ref": "#/$defs/count"
        },
        "request_id_missing": {
          "$ref": "#/$defs/count"
        },
        "request_id_missing_merged": {
          "$ref": "#/$defs/count"
        },
        "synthetic_nonzero_usage": {
          "$ref": "#/$defs/count"
        },
        "turn_identity_missing": {
          "$ref": "#/$defs/count"
        },
        "claude_nonterminal_snapshot": {
          "$ref": "#/$defs/count"
        },
        "claude_attribution_conflict": {
          "$ref": "#/$defs/count"
        },
        "claude_duplicate_tool_use": {
          "$ref": "#/$defs/count"
        },
        "claude_duplicate_turn": {
          "$ref": "#/$defs/count"
        },
        "claude_tool_status_conflict": {
          "$ref": "#/$defs/count"
        },
        "orphan_tool_result": {
          "$ref": "#/$defs/count"
        },
        "codex_repeat_total": {
          "$ref": "#/$defs/count"
        },
        "codex_last_delta_mismatch": {
          "$ref": "#/$defs/count"
        },
        "codex_embedded_parent_meta": {
          "$ref": "#/$defs/count"
        },
        "codex_replay_dropped": {
          "$ref": "#/$defs/count"
        },
        "codex_replay_tool_dropped": {
          "$ref": "#/$defs/count"
        },
        "codex_replay_turn_dropped": {
          "$ref": "#/$defs/count"
        },
        "codex_fork_history_unverified": {
          "$ref": "#/$defs/count"
        },
        "baseline_reset_assumed": {
          "$ref": "#/$defs/count"
        },
        "retry_ambiguous_order": {
          "$ref": "#/$defs/count"
        },
        "rowsRead": {
          "$ref": "#/$defs/count"
        },
        "rowsRecognised": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [],
      "additionalProperties": false
